# Wazuh Manager Log Rotation
# Generated by Ansible

{{ wazuh_manager_log_path }}/*.log
{{ wazuh_manager_log_path }}/*.json
{{ wazuh_manager_log_path }}/ossec/*.log
{{ wazuh_manager_log_path }}/ossec/*.json
{{ wazuh_manager_log_path }}/api/*.log
{
    daily
    rotate {{ wazuh_log_rotation_keep_days | default(30) }}
    size {{ wazuh_log_rotation_max_size | default('100M') }}
    missingok
    notifempty
{% if wazuh_log_rotation_compress | default(true) %}
    compress
    delaycompress
{% endif %}
    create 0640 {{ wazuh_manager_owner }} {{ wazuh_manager_group }}
    sharedscripts
    postrotate
        /bin/systemctl reload wazuh-manager > /dev/null 2>&1 || true
    endscript
}

# Wazuh alerts and archives rotation
{{ wazuh_manager_log_path }}/alerts/*.log
{{ wazuh_manager_log_path }}/alerts/*.json
{{ wazuh_manager_log_path }}/archives/*.log
{{ wazuh_manager_log_path }}/archives/*.json
{
    daily
    rotate {{ wazuh_log_rotation_keep_days | default(30) }}
    size {{ wazuh_log_rotation_max_size | default('100M') }}
    missingok
    notifempty
{% if wazuh_log_rotation_compress | default(true) %}
    compress
    delaycompress
{% endif %}
    create 0640 {{ wazuh_manager_owner }} {{ wazuh_manager_group }}
}
