# Wazuh - Filebeat configuration file
# Generated by Ansible
# Configured for automatic index rollover management

output.elasticsearch:
  hosts:
{% for node in wazuh_indexer_nodes %}
    - "{{ node.ip }}:{{ wazuh_indexer_http_port }}"
{% endfor %}
  protocol: https
  username: "{{ wazuh_filebeat_user | default('filebeat_writer') }}"
  password: "{{ wazuh_filebeat_password }}"
  ssl.certificate_authorities:
    - /etc/filebeat/certs/root-ca.pem
  ssl.certificate: "/etc/filebeat/certs/filebeat.pem"
  ssl.key: "/etc/filebeat/certs/filebeat-key.pem"
  ssl.verification_mode: "full"
  ssl.supported_protocols:
    - TLSv1.2
    - TLSv1.3
  ssl.cipher_suites:
    - ECDHE-ECDSA-AES256-GCM-SHA384
    - ECDHE-RSA-AES256-GCM-SHA384
    - ECDHE-ECDSA-CHACHA20-POLY1305
    - ECDHE-RSA-CHACHA20-POLY1305
    - ECDHE-ECDSA-AES128-GCM-SHA256
    - ECDHE-RSA-AES128-GCM-SHA256
  ssl.renegotiation: "never"
{% if wazuh_rollover_enabled | default(true) %}
  # Write to rollover alias instead of direct index
  # ISM policy handles rollover to new indices automatically
  index: "{{ wazuh_alerts_alias | default('wazuh-alerts') }}"
{% endif %}

setup.template.json.enabled: true
setup.template.json.path: '/etc/filebeat/wazuh-template.json'
setup.template.json.name: 'wazuh'
{% if wazuh_rollover_enabled | default(true) %}
# Required when output.elasticsearch.index is customized for rollover
setup.template.name: 'wazuh'
setup.template.pattern: 'wazuh-*'
{% endif %}
setup.ilm.overwrite: {{ wazuh_filebeat_ilm_overwrite | default(false) | lower }}
setup.ilm.enabled: false

filebeat.modules:
  - module: wazuh
    alerts:
      enabled: true
{% if wazuh_rollover_enabled | default(true) %}
      # Use write alias for automatic rollover support
      index: "{{ wazuh_alerts_alias | default('wazuh-alerts') }}"
{% endif %}
    archives:
      enabled: {{ wazuh_filebeat_archives_enabled | default(false) | lower }}
{% if wazuh_rollover_enabled | default(true) and wazuh_filebeat_archives_enabled | default(false) %}
      # Use write alias for automatic rollover support
      index: "{{ wazuh_archives_alias | default('wazuh-archives') }}"
{% endif %}

logging.level: info
logging.to_files: true
logging.files:
  path: /var/log/filebeat
  name: filebeat
  keepfiles: 7
  permissions: 0640
