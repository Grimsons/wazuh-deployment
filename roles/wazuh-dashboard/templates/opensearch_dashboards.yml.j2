# Wazuh Dashboard Configuration
# Generated by Ansible

# Server settings
server.host: {{ wazuh_dashboard_host | default(ansible_default_ipv4.address) }}
server.port: {{ wazuh_dashboard_port }}
server.name: "wazuh-dashboard"

# SSL/TLS settings
server.ssl.enabled: {{ wazuh_dashboard_ssl_enabled | lower }}
server.ssl.certificate: {{ wazuh_dashboard_certs_path }}/dashboard.pem
server.ssl.key: {{ wazuh_dashboard_certs_path }}/dashboard-key.pem
server.ssl.supportedProtocols:
  - TLSv1.2
  - TLSv1.3

# Opensearch connection
opensearch.hosts:
{% for node in wazuh_indexer_nodes %}
  - https://{{ node.ip }}:{{ wazuh_indexer_http_port }}
{% endfor %}

opensearch.ssl.verificationMode: {{ wazuh_dashboard_ssl_verification_mode | default('full') }}
opensearch.username: "{{ wazuh_indexer_admin_user }}"
opensearch.password: "{{ wazuh_indexer_admin_password }}"
opensearch.ssl.certificateAuthorities:
  - {{ wazuh_dashboard_certs_path }}/root-ca.pem
opensearch.requestHeadersWhitelist:
  - securitytenant
  - Authorization

# Security settings
opensearch_security.multitenancy.enabled: false
opensearch_security.readonly_mode.roles:
  - kibana_read_only

# Cookie security settings
opensearch_security.cookie.secure: {{ wazuh_dashboard_cookie_secure | default(true) | lower }}
opensearch_security.cookie.isSameSite: "{{ wazuh_dashboard_cookie_same_site | default('Strict') }}"

# HTTP security headers
server.customResponseHeaders:
  X-Frame-Options: "{{ wazuh_dashboard_xframe_options | default('DENY') }}"
  X-Content-Type-Options: "nosniff"
  Strict-Transport-Security: "max-age=63072000; includeSubDomains; preload"
  Referrer-Policy: "no-referrer"
  Permissions-Policy: "accelerometer=(), camera=(), geolocation=(), microphone=(), payment=()"
  # X-XSS-Protection intentionally omitted — deprecated header, can introduce XS-Leaks.
  # Protection is provided by the Content-Security-Policy below.
{% if wazuh_dashboard_csp_strict | default(true) %}
  # 'unsafe-eval' is required by OpenSearch Dashboards AngularJS runtime and cannot
  # be removed without upstream changes. 'unsafe-inline' is removed from script-src
  # to limit XSS surface; inline styles are still needed by UI components.
  Content-Security-Policy: "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https:; worker-src 'self' blob:; frame-ancestors '{{ 'none' if (wazuh_dashboard_xframe_options | default('DENY')) == 'DENY' else 'self' }}'"
{% endif %}

# UI settings
# Note: defaultRoute to /app/wazuh can cause "Application Not Found" errors
# Users should navigate to Wazuh from the menu instead
# uiSettings.overrides.defaultRoute: /app/wazuh

# Logging
logging.dest: /var/log/wazuh-dashboard/opensearch-dashboards.log

# Session timeout (in milliseconds)
opensearch_security.session.ttl: {{ (wazuh_dashboard_session_timeout | default(60)) * 60000 }}
opensearch_security.cookie.ttl: {{ (wazuh_dashboard_session_timeout | default(60)) * 60000 }}
