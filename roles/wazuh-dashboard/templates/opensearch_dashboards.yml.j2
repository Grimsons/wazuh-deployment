# Wazuh Dashboard Configuration
# Generated by Ansible

# Server settings
server.host: "{{ wazuh_dashboard_host | default('0.0.0.0') }}"
server.port: {{ wazuh_dashboard_port }}
server.name: "wazuh-dashboard"

# SSL/TLS settings
server.ssl.enabled: {{ wazuh_dashboard_ssl_enabled | lower }}
server.ssl.certificate: "{{ wazuh_dashboard_certs_path }}/{{ dashboard_node_name | default('dashboard-1') }}.pem"
server.ssl.key: "{{ wazuh_dashboard_certs_path }}/{{ dashboard_node_name | default('dashboard-1') }}-key.pem"
server.ssl.supportedProtocols:
  - TLSv1.2
  - TLSv1.3

# Opensearch connection
opensearch.hosts:
{% for node in wazuh_indexer_nodes | default([]) %}
  - "https://{{ node.ip }}:{{ wazuh_indexer_http_port | default(9200) }}"
{% endfor %}

opensearch.ssl.verificationMode: "{{ wazuh_dashboard_ssl_verification_mode | default('certificate') }}"
opensearch.username: "{{ wazuh_indexer_admin_user | default('admin') }}"
opensearch.password: "{{ wazuh_indexer_admin_password | default('') }}"
opensearch.ssl.certificateAuthorities:
  - "{{ wazuh_dashboard_certs_path }}/root-ca.pem"
opensearch.requestHeadersWhitelist:
  - securitytenant
  - Authorization

# Security settings
opensearch_security.multitenancy.enabled: false
opensearch_security.readonly_mode.roles:
  - kibana_read_only

# Cookie security settings
opensearch_security.cookie.secure: {{ wazuh_dashboard_cookie_secure | default(true) | lower }}
opensearch_security.cookie.isSameSite: "{{ wazuh_dashboard_cookie_same_site | default('Strict') }}"

# HTTP security headers
server.customResponseHeaders:
  X-Frame-Options: "{{ wazuh_dashboard_xframe_options | default('SAMEORIGIN') }}"
  X-Content-Type-Options: "nosniff"
  X-XSS-Protection: "1; mode=block"
  Strict-Transport-Security: "max-age={{ wazuh_dashboard_hsts_max_age | default(31536000) }}; includeSubDomains"
{% if wazuh_dashboard_csp_strict | default(true) %}
  Content-Security-Policy: "default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https:; frame-ancestors 'self'"
{% endif %}

# UI settings
# The home app is deprecated/unavailable in OSD 3.x; using it as defaultRoute
# shows "Application Not Found". Use /app/dashboards instead.
uiSettings.overrides.defaultRoute: /app/dashboards

# Logging
logging.dest: /var/log/wazuh-dashboard/opensearch-dashboards.log

# Session timeout (in milliseconds)
opensearch_security.session.ttl: {{ (wazuh_dashboard_session_timeout | default(60)) * 60000 }}
opensearch_security.cookie.ttl: {{ (wazuh_dashboard_session_timeout | default(60)) * 60000 }}
