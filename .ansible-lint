---
profile: production
skip_list:
  # Pre-existing violations — fix in dedicated cleanup PR
  - yaml[indentation]
  - yaml[line-length]
  - yaml[document-start]
  - no-changed-when
  - no-ignore-errors
  - no-handler
  - experimental
  - risky-shell-pipe
  - risky-file-permissions
  - package-latest
  - fqcn-builtins
  - fqcn[canonical]
  - name[casing]
  - name[prefix]
  - name[missing]
  - var-naming[no-role-prefix]
  - key-order
  - command-instead-of-shell
  - role-name
  - unnamed-task
exclude_paths:
  - .git/
  - .github/
  - molecule/
  - roles/*/molecule/
