<!--
  Vulnerability Detector Escalation Rules
  Rule ID range: 800700-800719
  Parent rule IDs: 87901 (Wazuh built-in vulnerability detector)

  Prerequisites:
    - wazuh_vulnerability_detection_enabled: true in group_vars
    - Vulnerability detector configured on the manager
-->
<group name="vulnerability-detector,custom_vuln_rules,">

  <!-- ═══ Critical CVE on Any Host ═══ -->
  <rule id="800700" level="12">
    <if_sid>87901</if_sid>
    <field name="vulnerability.severity">Critical</field>
    <description>Critical vulnerability detected: $(vulnerability.cve) on $(hostname) - CVSS: $(vulnerability.cvss.cvss3.base_score)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>vulnerability,critical_vuln,</group>
  </rule>

  <!-- ═══ Critical CVE with Known Exploit Available ═══ -->
  <rule id="800701" level="14">
    <if_sid>800700</if_sid>
    <field name="vulnerability.exploitability_score">.+</field>
    <description>Critical vulnerability with known exploit: $(vulnerability.cve) on $(hostname) - immediate patching required</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>vulnerability,critical_vuln,exploit_available,attack,</group>
  </rule>

  <!-- ═══ High CVE — Informational Aggregation ═══ -->
  <rule id="800702" level="8">
    <if_sid>87901</if_sid>
    <field name="vulnerability.severity">High</field>
    <description>High severity vulnerability detected: $(vulnerability.cve) on $(hostname)</description>
    <group>vulnerability,</group>
  </rule>

</group>
