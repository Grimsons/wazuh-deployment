# Auto-detect text files and normalize to LF on checkout
* text=auto

# Explicitly enforce LF for text file types commonly edited on Windows
*.sh text eol=lf
*.bash text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.cfg text eol=lf
*.conf text eol=lf
*.j2 text eol=lf
*.xml text eol=lf
*.py text eol=lf
*.json text eol=lf
*.txt text eol=lf

# Binary files — never touch
*.pem binary
*.key binary
*.cert binary
*.crt binary
*.tar.gz binary
*.zip binary
